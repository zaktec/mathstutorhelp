---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import CourseGrid from '~/components/widgets/CourseGrid.astro';
import MembershipComparison from '~/components/widgets/MembershipComparison.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import { onlineCourseCards, onlinePackages, registerInterestUrl } from '~/utils/onlineCourses';
import { siteImages } from '~/data/images';
import { bookingLinks, contactDetails, tuitionPrices } from '~/utils/siteDetails';

const metadata = {
  title: 'Online Maths Tuition & Courses',
  description:
    'Online course memberships and live tuition for Year 6, KS3, GCSE, IGCSE, Functional Skills and A-Level Maths, plus Maths Challenge and Python pathways.',
};

const popularCourseSlugs = ['gcse-foundation-maths', 'gcse-higher-maths', 'ks3-maths', 'a-level-maths'];
const popularCourses = onlineCourseCards.filter((course) => popularCourseSlugs.includes(course.slug));
const moreCourses = onlineCourseCards.filter((course) => !popularCourseSlugs.includes(course.slug));
const onlineEnquiryUrl = '/contact/?enquiry=online#general-enquiry';
const liveTuitionEnquiryUrl = '/contact/?enquiry=one-to-one#general-enquiry';
const whatsappMessage = encodeURIComponent(
  "Hi Mr Sheraz, I'm interested in online maths tuition. The student is in Year __ and needs help with __."
);
const whatsappUrl = `${contactDetails.whatsappHref}?text=${whatsappMessage}`;
const onlineServiceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': 'https://mathstutorhelp.com/online-tuition/#service',
  name: 'Online Maths Tuition and Course Memberships',
  url: 'https://mathstutorhelp.com/online-tuition/',
  provider: { '@id': 'https://mathstutorhelp.com/#mathstutorhelp' },
  areaServed: 'United Kingdom',
  serviceType: 'Online maths tuition',
  offers: [
    { '@type': 'Offer', name: 'Bronze monthly membership', price: '19', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Silver monthly membership', price: '49', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Gold monthly membership', price: '89', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Full course access', price: '99', priceCurrency: 'GBP' },
    { '@type': 'Offer', name: 'Live one-to-one online tuition', price: '25', priceCurrency: 'GBP' },
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(onlineServiceSchema)} />

  <Hero
    tagline="MathsTutorHelp Online"
    title="Online Maths Tuition & Course Memberships"
    subtitle="Structured online courses for students who need regular guidance, weekly practice and expert tutor support — without committing to weekly one-to-one lessons."
    content={`<ul class="mx-auto mt-6 grid max-w-2xl gap-2 text-left text-sm font-medium text-gray-800 dark:text-slate-200 sm:text-base"><li>✓ One selected course or pathway level matched to the student</li><li>✓ New lessons released weekly to support steady progress</li><li>✓ Tutor-monitored progress in every package</li><li>✓ Live online tutor support included with Silver and Gold</li></ul>`}
    actions={[
      {
        variant: 'primary',
        text: 'Discuss Online Tuition',
        href: onlineEnquiryUrl,
      },
      { text: 'Compare Plans', href: '#plans' },
    ]}
    image={{
      src: siteImages.onlinePackages,
      alt: 'Online maths tutoring packages',
    }}
  />

  <section class="bg-brand-soft py-12 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">
          Choose the Right Format
        </p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-950 dark:text-white">
          Live Tuition or an Online Course Membership?
        </h2>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        <article
          class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-slate-800"
        >
          <h3 class="text-xl font-bold text-gray-950 dark:text-white">Live Online Tuition</h3>
          <p class="mt-3 leading-7 text-muted dark:text-slate-300">
            A scheduled one-to-one lesson with Mr Sheraz, adapted in real time to the student’s questions and goals,
            priced separately at <strong>{tuitionPrices.online.display}</strong>.
          </p>
          <a class="btn-secondary mt-5 justify-center" href={liveTuitionEnquiryUrl}>Discuss Live Tuition</a>
        </article>
        <article
          class="rounded-lg border border-primary/30 bg-white p-6 shadow-sm dark:border-teal-300 dark:bg-slate-800"
        >
          <h3 class="text-xl font-bold text-gray-950 dark:text-white">Online Course Memberships</h3>
          <p class="mt-3 leading-7 text-muted dark:text-slate-300">
            A selected platform course released week by week, with tutor monitoring. Silver and Gold also include a
            fixed number of live online lessons each month.
          </p>
          <a class="btn-primary mt-5 justify-center" href="#plans">Compare Plans</a>
        </article>
      </div>

      <div
        class="mt-8 overflow-x-auto rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-slate-800"
      >
        <table class="w-full min-w-[760px] text-left text-sm">
          <caption class="sr-only">Comparison of online maths tuition and course options</caption>
          <thead class="bg-gray-50 text-gray-950 dark:bg-slate-950 dark:text-white">
            <tr>
              <th class="p-4 font-bold" scope="col">Option</th>
              <th class="p-4 font-bold" scope="col">Best for</th>
              <th class="p-4 font-bold" scope="col">Course access</th>
              <th class="p-4 font-bold" scope="col">Live lessons</th>
              <th class="p-4 font-bold" scope="col">Price</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 text-muted dark:divide-gray-700 dark:text-slate-300">
            <tr
              ><th class="p-4 text-gray-950 dark:text-white" scope="row">Live one-to-one</th><td class="p-4"
                >Personal teaching</td
              ><td class="p-4">Not included</td><td class="p-4">Book as needed</td><td class="p-4 font-semibold"
                >{tuitionPrices.online.display}</td
              ></tr
            >
            <tr
              ><th class="p-4 text-gray-950 dark:text-white" scope="row">Bronze</th><td class="p-4"
                >Independent learners</td
              ><td class="p-4">One course, weekly release</td><td class="p-4">None</td><td class="p-4 font-semibold"
                >£19/month</td
              ></tr
            >
            <tr
              ><th class="p-4 text-gray-950 dark:text-white" scope="row">Silver</th><td class="p-4"
                >Guided monthly support</td
              ><td class="p-4">One course, weekly release</td><td class="p-4">One 55-minute lesson/month</td><td
                class="p-4 font-semibold">£49/month</td
              ></tr
            >
            <tr
              ><th class="p-4 text-gray-950 dark:text-white" scope="row">Gold</th><td class="p-4"
                >Regular personalised support</td
              ><td class="p-4">One course, weekly release</td><td class="p-4">Two 55-minute lessons/month</td><td
                class="p-4 font-semibold">£89/month</td
              ></tr
            >
            <tr
              ><th class="p-4 text-gray-950 dark:text-white" scope="row">Full course</th><td class="p-4"
                >Self-paced learning</td
              ><td class="p-4">One course immediately</td><td class="p-4">None</td><td class="p-4 font-semibold"
                >£99 once</td
              ></tr
            >
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <MembershipComparison packages={onlinePackages} enquiryUrl={registerInterestUrl} />

  <Features
    tagline="Three Simple Steps"
    title="How online support works"
    subtitle="Choose the support level first, then I’ll help match the student to one suitable course or pathway level."
    columns={3}
    items={[
      {
        title: '1. Choose support',
        description: 'Compare independent course access, monthly live guidance or one-to-one tuition.',
        icon: 'tabler:books',
      },
      {
        title: '2. Match the course',
        description: 'I’ll help select one maths course or pathway level matched to the student’s stage and goals.',
        icon: 'tabler:list-check',
      },
      {
        title: '3. Learn week by week',
        description:
          'Membership lessons are released gradually, with monitoring in every plan and live help in Silver and Gold.',
        icon: 'tabler:video',
      },
    ]}
  />

  <section class="bg-white py-14 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Online Courses</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-950 dark:text-white md:text-4xl">
          Choose Your Course
        </h2>
        <p class="mt-4 text-lg leading-8 text-muted dark:text-slate-300">
          Start with the student’s subject and level, then choose how much monthly tutor support they need.
        </p>
      </div>

      <div class="mt-10 space-y-12">
        <CourseGrid title="Popular Maths Courses" courses={popularCourses} />
        <details class="rounded-lg border border-gray-200 bg-gray-50 p-5 dark:border-gray-700 dark:bg-slate-800">
          <summary class="cursor-pointer text-lg font-bold text-primary">View all other online courses</summary>
          <div class="mt-6">
            <CourseGrid
              title="More Maths, Challenge and Coding Courses"
              courses={moreCourses}
              featuredSlugs={['maths-challenge-problem-solving-club']}
            />
          </div>
        </details>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Before You Subscribe</p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-950 dark:text-white">Clear Monthly Arrangements</h2>
        <p class="mt-4 leading-7 text-muted dark:text-slate-300">
          Registering interest does not take payment. Your selected course, start date, billing date and support
          arrangements are confirmed in writing before the membership begins.
        </p>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        <article class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
          <h3 class="text-xl font-bold text-gray-950 dark:text-white">Billing and cancellation</h3>
          <p class="mt-3 leading-7 text-muted dark:text-slate-300">
            Memberships are monthly with no long-term contract. Renewal, cancellation timing and any refund arrangements
            are confirmed before payment.
          </p>
        </article>
        <article class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
          <h3 class="text-xl font-bold text-gray-950 dark:text-white">Live lesson scheduling</h3>
          <p class="mt-3 leading-7 text-muted dark:text-slate-300">
            Silver and Gold lesson times are agreed subject to tutor availability. Rescheduling, missed-lesson and
            unused-lesson arrangements are confirmed before the first payment.
          </p>
        </article>
        <article class="rounded-lg border border-gray-200 p-6 dark:border-gray-700">
          <h3 class="text-xl font-bold text-gray-950 dark:text-white">Weekly tutor support</h3>
          <p class="mt-3 leading-7 text-muted dark:text-slate-300">
            Completed work is reviewed as part of the weekly learning cycle. WhatsApp is limited to short course
            questions and guidance and normally receives a reply within 24 hours.
          </p>
        </article>
      </div>
    </div>
  </section>

  <Testimonials
    tagline="Student Feedback"
    title="What Online Learners Say"
    subtitle="Feedback shared with permission. Names are withheld for student and family privacy."
    classes={{ container: 'py-8 md:py-10 lg:py-12' }}
    testimonials={[
      {
        title: 'Helpful exam practice',
        testimonial:
          'I understand the methods much better now, especially when working through past-paper questions step by step.',
        name: 'A-Level student',
        job: 'Online tuition',
      },
      {
        title: 'Clear explanations',
        testimonial:
          'Mr Sheraz explains topics clearly and gives my child the confidence to try exam questions independently.',
        name: 'GCSE parent',
        job: 'Manchester',
      },
      {
        title: 'Confidence improved',
        testimonial:
          'The lessons are structured and calm. We can see better confidence and stronger exam technique each week.',
        name: 'Year 11 parent',
        job: 'Levenshulme',
      },
    ]}
  />

  <section class="bg-white py-12 dark:bg-slate-900">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div
        class="rounded-lg border border-gray-200 bg-gray-50 p-6 shadow-sm dark:border-gray-700 dark:bg-slate-800 sm:p-8"
      >
        <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Optional Extra</p>
            <h2 class="mt-2 text-2xl font-bold text-gray-950 dark:text-white">Want instant full-course access?</h2>
            <p class="mt-3 leading-7 text-muted dark:text-slate-300">
              For families who prefer self-paced learning, access to one selected course or pathway level can be
              purchased separately.
            </p>
            <h3 class="mt-5 text-lg font-bold text-gray-950 dark:text-white">Full Course Access includes:</h3>
            <ul class="mt-3 grid gap-2 text-sm leading-6 text-muted dark:text-slate-300 sm:grid-cols-2">
              <li>✓ One selected course or pathway level unlocked immediately</li>
              <li>✓ Self-paced learning</li>
              <li>✓ Worksheets and practice tasks</li>
              <li>✓ No live lesson included</li>
              <li>✓ No monthly subscription required</li>
            </ul>
          </div>
          <div class="md:min-w-56 md:text-center">
            <p class="text-3xl font-extrabold text-primary">£99 one-off</p>
            <a class="btn-secondary mt-4 w-full justify-center" href={`${registerInterestUrl}&plan=full-course`}
              >Discuss Full Course Access</a
            >
            <p class="mt-3 text-sm leading-6 text-muted dark:text-slate-400">
              The access period and included materials are confirmed before purchase.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQs
    title="Online Tuition FAQs"
    columns={2}
    items={[
      {
        title: 'Do students get access to every course?',
        description:
          'No. Each membership includes one selected course or one level from a multi-level pathway. Extra access can be added if needed.',
      },
      {
        title: 'Why are lessons released weekly?',
        description:
          'Weekly release helps students build understanding gradually and avoids rushing through the course without enough practice.',
      },
      {
        title: 'How does the tutor monitor progress?',
        description:
          'The tutor reviews completed lessons and practice work, checks understanding and uses this information to guide the student’s next steps.',
      },
      {
        title: 'Is Bronze enough?',
        description:
          'Bronze is best for independent learners who mainly need structure, worksheets and light support. Students who need live tutor help should choose Silver or Gold.',
      },
      {
        title: 'Is Silver or Gold better for GCSE?',
        description:
          'Silver is suitable for light monthly guidance. Gold is better for students who need more regular GCSE exam preparation and personalised support.',
      },
      {
        title: 'Is WhatsApp support unlimited?',
        description:
          'No. WhatsApp support is for short course questions and guidance. It is not a replacement for live tutoring.',
      },
      {
        title: 'Can my child book extra lessons?',
        description: 'Yes. Extra one-to-one lessons can be booked separately if more support is needed.',
      },
      {
        title: 'Can I cancel?',
        description:
          'Yes. There is no long-term contract. The date cancellation takes effect and any refund arrangements are confirmed before payment.',
      },
      {
        title: 'What equipment is needed?',
        description:
          'Students need a suitable computer or tablet, a reliable internet connection and a current web browser. Any video platform or additional software is confirmed before live lessons begin.',
      },
      {
        title: 'How are under-18s supported safely?',
        description:
          'A parent or guardian manages the initial enquiry and booking. Communication and any lesson-recording arrangements follow the <a class="underline" href="/safeguarding/">safeguarding policy</a> and are agreed before tuition begins.',
      },
    ]}
  />

  <CallToAction
    title="Not Sure Which Online Option to Choose?"
    subtitle="Tell me what support your child needs and I will help you choose the right monthly option."
    actions={[
      {
        variant: 'primary',
        text: 'Discuss Online Tuition',
        href: onlineEnquiryUrl,
        icon: 'tabler:message-circle',
      },
      { text: `WhatsApp me — ${contactDetails.phoneDisplay}`, href: whatsappUrl, icon: 'tabler:brand-whatsapp' },
      { text: 'Book a Free Consultation', href: bookingLinks.freeConsultation, icon: 'tabler:calendar-check' },
    ]}
  />
</Layout>
