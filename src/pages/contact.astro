---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { Icon } from 'astro-icon/components';
import { bookingLinks, contactDetails } from '~/utils/siteDetails';

const metadata = {
  title: 'Contact Manchester Maths Tutor',
  description:
    'Contact MathsTutorHelp in Manchester by phone, WhatsApp or online form for GCSE, IGCSE, Functional Skills, A-Level and group maths tuition.',
};

const contactOptions = [
  {
    title: 'Send a WhatsApp',
    description: 'Best for a quick question. I normally reply within 24 hours.',
    action: 'Message me',
    href: contactDetails.whatsappHref,
    icon: 'tabler:brand-whatsapp',
  },
  {
    title: 'Call MathsTutorHelp',
    description: `Speak to me directly on ${contactDetails.phoneDisplay}.`,
    action: 'Call now',
    href: contactDetails.phoneHref,
    icon: 'tabler:phone',
  },
  {
    title: 'Book a consultation',
    description: 'Choose a convenient time for a free introductory conversation.',
    action: 'Choose a time',
    href: bookingLinks.freeConsultation,
    icon: 'tabler:calendar-event',
  },
];

const applicationForms = [
  {
    title: 'Group maths classes',
    description: 'Register a student for KS3 or GCSE small-group tuition.',
    action: 'Open group class form',
    href: bookingLinks.groupClassForm,
  },
  {
    title: 'One-to-one tuition',
    description: 'Tell me about the student and the individual support they need.',
    action: 'Open one-to-one form',
    href: bookingLinks.oneToOneForm,
  },
  {
    title: 'Online course',
    description: 'Register interest in structured online maths support.',
    action: 'Open online course form',
    href: bookingLinks.onlineCourseForm,
    isExternal: true,
  },
  {
    title: 'Work with MathsTutorHelp',
    description: 'Tutors and other talented people can introduce themselves on our dedicated work page.',
    action: 'View opportunities',
    href: '/work-with-mth/',
    isExternal: false,
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Get in Touch"
    title="Contact MathsTutorHelp"
    subtitle="Have a question or want to discuss tuition? Send a message, call, use WhatsApp or choose a specialist form."
    callToAction={{
      variant: 'primary',
      text: 'Choose a Contact Option',
      href: '#contact-options',
      icon: 'tabler:message-circle',
    }}
  />

  <section id="contact-options" aria-labelledby="contact-options-title" class="bg-brand-soft py-12 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Contact hub</p>
        <h2 id="contact-options-title" class="mt-2 text-3xl font-bold tracking-tight text-gray-950 dark:text-white">
          How would you like to get in touch?
        </h2>
      </div>

      <div class="mx-auto mt-8 max-w-4xl rounded-xl border border-primary/20 bg-white p-6 shadow-sm sm:p-8 dark:border-primary/30 dark:bg-slate-900">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <Icon name="tabler:message-circle" class="h-6 w-6" />
          </span>
          <div>
            <h3 class="text-2xl font-bold text-gray-950 dark:text-white">General question or enquiry</h3>
            <p class="mt-1 leading-7 text-muted dark:text-slate-300">
              Send a message using the form below. I normally reply within 24 hours.
            </p>
          </div>
        </div>

        <div
          id="contact-success"
          class="mt-6 hidden rounded-lg border border-green-200 bg-green-50 p-5 text-green-900 dark:border-green-800 dark:bg-green-950/40 dark:text-green-100"
          role="status"
          aria-live="polite"
          tabindex="-1"
        >
          <p class="text-lg font-bold">Thank you for getting in touch.</p>
          <p class="mt-1">Your enquiry has been received successfully. I’ll get back to you as soon as possible.</p>
        </div>

        <form id="contact-form" class="mt-6" novalidate={false}>
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Name <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Email address <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                inputmode="email"
                required
              />
            </div>
          </div>

          <div class="mt-5 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="phone" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Phone number <span class="font-normal text-muted dark:text-slate-400">(optional)</span>
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                inputmode="tel"
              />
            </div>
            <div>
              <label for="subject" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Subject <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                type="text"
                id="subject"
                name="subject"
                required
              />
            </div>
          </div>

          <div class="mt-5">
            <label for="message" class="block text-sm font-semibold text-gray-900 dark:text-white">
              Message <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
            </label>
            <textarea
              class="mt-2 min-h-36 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
              id="message"
              name="message"
              rows="6"
              required
            ></textarea>
          </div>

          <div class="mt-5 flex items-start gap-3">
            <input
              class="mt-1 h-5 w-5 shrink-0 cursor-pointer rounded border-gray-300 text-primary focus:ring-primary"
              type="checkbox"
              id="consent"
              name="consent"
              required
            />
            <label for="consent" class="cursor-pointer text-sm leading-6 text-gray-700 dark:text-slate-300">
              I agree for MathsTutorHelp to contact me about my enquiry.
              <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
            </label>
          </div>

          <div
            id="contact-error"
            class="mt-5 hidden rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 dark:border-red-800 dark:bg-red-950/40 dark:text-red-200"
            role="alert"
            aria-live="assertive"
            tabindex="-1"
          ></div>

          <button id="contact-submit" class="btn-primary mt-6 min-h-12 w-full justify-center" type="submit">
            Send enquiry
          </button>
        </form>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          contactOptions.map(({ title, description, action, href, icon }) => (
            <a
              href={href}
              class="group rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-slate-900"
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <Icon name={icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 text-xl font-bold text-gray-950 dark:text-white">{title}</h3>
              <p class="mt-2 leading-7 text-muted dark:text-slate-300">{description}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-primary">
                {action}
                <Icon name="tabler:arrow-right" class="h-5 w-5 transition group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-10 rounded-xl border border-gray-200 bg-white p-5 sm:p-8 dark:border-gray-700 dark:bg-slate-900">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Registration forms</p>
          <h3 class="mt-2 text-2xl font-bold text-gray-950 dark:text-white">Choose a specialist form</h3>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {
            applicationForms.map(({ title, description, action, href, isExternal = true }) => (
              <div class="flex flex-col rounded-lg border border-gray-200 p-5 dark:border-gray-700">
                <h4 class="text-lg font-bold text-gray-950 dark:text-white">{title}</h4>
                <p class="mt-2 grow text-sm leading-6 text-muted dark:text-slate-300">{description}</p>
                <a class="mt-4 inline-flex items-center gap-2 font-semibold text-primary hover:underline" href={href}>
                  {action}
                  <Icon name={isExternal ? 'tabler:external-link' : 'tabler:arrow-right'} class="h-4 w-4" />
                </a>
              </div>
            ))
          }
        </div>
        <p class="mt-5 text-sm text-muted dark:text-slate-400">
          Forms marked with the external-link icon continue securely to the Hai‑BL platform.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
  const errorMessage = document.querySelector<HTMLElement>('#contact-error');
  const successMessage = document.querySelector<HTMLElement>('#contact-success');

  let formStartedAt = Date.now();
  let isSubmitting = false;

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (isSubmitting || !contactForm.checkValidity()) {
      contactForm.reportValidity();
      return;
    }

    isSubmitting = true;
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending enquiry...';
    }
    errorMessage?.classList.add('hidden');
    if (errorMessage) errorMessage.textContent = '';

    const formData = new FormData(contactForm);
    const payload = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      phone: String(formData.get('phone') ?? ''),
      subject: String(formData.get('subject') ?? ''),
      message: String(formData.get('message') ?? ''),
      consent: formData.get('consent') === 'on',
      website: String(formData.get('website') ?? ''),
      formStartedAt,
    };

    try {
      const response = await fetch('https://hai-bl.com/api/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
      });

      const result = (await response.json()) as { success?: boolean; message?: string; error?: string };

      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Your enquiry could not be sent. Please try again.');
      }

      contactForm.reset();
      contactForm.classList.add('hidden');
      successMessage?.classList.remove('hidden');
      successMessage?.focus();
      formStartedAt = Date.now();
    } catch (error) {
      const message = error instanceof Error ? error.message : 'Your enquiry could not be sent. Please try again.';
      if (errorMessage) {
        errorMessage.textContent = message;
        errorMessage.classList.remove('hidden');
        errorMessage.focus();
      }
    } finally {
      isSubmitting = false;
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Send enquiry';
      }
    }
  });
</script>
