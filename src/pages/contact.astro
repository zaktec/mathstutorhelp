---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import { Icon } from 'astro-icon/components';
import { bookingLinks, contactDetails, courseSchedule } from '~/utils/siteDetails';

const metadata = {
  title: 'Contact Manchester Maths Tutor',
  description:
    'Contact MathsTutorHelp in Manchester by phone, WhatsApp or online form for GCSE, IGCSE, Functional Skills, A-Level and group maths tuition.',
};

const contactOptions = [
  {
    title: 'Send a WhatsApp',
    description: 'Best for a quick question. I normally reply within 24 hours.',
    action: 'Message me',
    href: contactDetails.whatsappHref,
    icon: 'tabler:brand-whatsapp',
  },
  {
    title: 'Call MathsTutorHelp',
    description: `Speak to me directly on ${contactDetails.phoneDisplay}.`,
    action: 'Call now',
    href: contactDetails.phoneHref,
    icon: 'tabler:phone',
  },
  {
    title: 'Book a consultation',
    description: 'Choose a convenient time for a free introductory conversation.',
    action: 'Choose a time',
    href: bookingLinks.freeConsultation,
    icon: 'tabler:calendar-event',
  },
];

const applicationForms = [
  {
    title: 'Group maths classes',
    description: 'Register interest in Foundation, Higher or other KS3 and GCSE small-group maths tuition.',
    action: 'Open group class form',
    href: bookingLinks.groupClassForm,
  },
  {
    title: 'Manchester Coding Club',
    description: 'Register interest in the small-group Python coding course for students aged 13–17.',
    action: 'Ask about coding club',
    href: '/contact/?enquiry=coding',
    isExternal: false,
  },
  {
    title: 'One-to-one tuition',
    description: 'Tell me about the student and the individual support they need.',
    action: 'Open one-to-one form',
    href: bookingLinks.oneToOneForm,
  },
  {
    title: 'Online course',
    description: 'Register interest in structured online maths support.',
    action: 'Open online course form',
    href: bookingLinks.onlineCourseForm,
    isExternal: true,
  },
  {
    title: 'Work with MathsTutorHelp',
    description: 'Tutors and other talented people can introduce themselves on our dedicated work page.',
    action: 'View opportunities',
    href: '/work-with-mth/',
    isExternal: false,
  },
];
---

<Layout metadata={metadata}>
  <HeroText
    tagline="Get in Touch"
    title="Contact MathsTutorHelp"
    subtitle="Have a question or want to discuss tuition? Send a message, call, use WhatsApp or choose a specialist form."
    callToAction={{
      variant: 'primary',
      text: 'Choose a Contact Option',
      href: '#contact-options',
      icon: 'tabler:message-circle',
    }}
  />

  <section id="contact-options" aria-labelledby="contact-options-title" class="bg-brand-soft py-12 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Contact hub</p>
        <h2 id="contact-options-title" class="mt-2 text-3xl font-bold tracking-tight text-gray-950 dark:text-white">
          How would you like to get in touch?
        </h2>
      </div>

      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {
          contactOptions.map(({ title, description, action, href, icon }) => (
            <a
              href={href}
              class="group rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-1 hover:border-primary hover:shadow-md dark:border-gray-700 dark:bg-slate-900"
            >
              <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <Icon name={icon} class="h-6 w-6" />
              </span>
              <h3 class="mt-5 text-xl font-bold text-gray-950 dark:text-white">{title}</h3>
              <p class="mt-2 leading-7 text-muted dark:text-slate-300">{description}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-primary">
                {action}
                <Icon name="tabler:arrow-right" class="h-5 w-5 transition group-hover:translate-x-1" />
              </span>
            </a>
          ))
        }
      </div>

      <div
        class="mx-auto mt-10 max-w-4xl rounded-xl border border-primary/20 bg-white p-6 shadow-sm sm:p-8 dark:border-primary/30 dark:bg-slate-900"
      >
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <Icon name="tabler:message-circle" class="h-6 w-6" />
          </span>
          <div>
            <h3 class="text-2xl font-bold text-gray-950 dark:text-white">General question or enquiry</h3>
            <p class="mt-1 leading-7 text-muted dark:text-slate-300">
              Send a message using the form below. I normally reply within 24 hours.
            </p>
          </div>
        </div>

        <div
          id="contact-success"
          class="mt-6 hidden rounded-lg border border-green-200 bg-green-50 p-5 text-green-900 dark:border-green-800 dark:bg-green-950/40 dark:text-green-100"
          role="status"
          aria-live="polite"
          tabindex="-1"
        >
          <p class="text-lg font-bold">Thank you for getting in touch.</p>
          <p class="mt-1">Your enquiry has been received successfully. I’ll get back to you as soon as possible.</p>
        </div>

        <form id="contact-form" class="mt-6" novalidate={false}>
          <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
            <label for="website">Website</label>
            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Name <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                type="text"
                id="name"
                name="name"
                autocomplete="name"
                required
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Email address <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                type="email"
                id="email"
                name="email"
                autocomplete="email"
                inputmode="email"
                required
              />
            </div>
          </div>

          <div class="mt-5 grid gap-5 sm:grid-cols-2">
            <div>
              <label for="phone" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Phone number <span class="font-normal text-muted dark:text-slate-400">(optional)</span>
              </label>
              <input
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                inputmode="tel"
              />
            </div>
            <div>
              <label for="enquiry-type" class="block text-sm font-semibold text-gray-900 dark:text-white">
                Enquiry type <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
              </label>
              <select
                class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                id="enquiry-type"
                name="enquiryType"
                required
              >
                <option value="">Choose an option</option>
                <option value="foundation">Foundation group class</option>
                <option value="higher">Higher group class</option>
                <option value="coding">Manchester Coding Club</option>
                <option value="group-maths">Other group maths tuition</option>
                <option value="one-to-one">One-to-one tuition</option>
                <option value="online">Online tuition</option>
                <option value="general">General question</option>
              </select>
            </div>
          </div>

          <fieldset class="mt-5 rounded-lg border border-gray-200 p-4 dark:border-gray-700">
            <legend class="px-1 text-sm font-semibold text-gray-900 dark:text-white">
              Student details <span class="font-normal text-muted dark:text-slate-400">(optional)</span>
            </legend>
            <p class="mb-4 text-sm leading-6 text-muted dark:text-slate-400">
              Please do not include the student’s full name at this enquiry stage.
            </p>
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="year-group" class="block text-sm font-semibold text-gray-900 dark:text-white"
                  >Year group</label
                >
                <input
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                  type="text"
                  id="year-group"
                  name="yearGroup"
                  placeholder="e.g. Year 11"
                />
              </div>
              <div>
                <label for="working-grade" class="block text-sm font-semibold text-gray-900 dark:text-white"
                  >Current grade</label
                >
                <input
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                  type="text"
                  id="working-grade"
                  name="workingGrade"
                  placeholder="e.g. Grade 4"
                />
              </div>
              <div>
                <label for="exam-board" class="block text-sm font-semibold text-gray-900 dark:text-white"
                  >Exam board</label
                >
                <input
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                  type="text"
                  id="exam-board"
                  name="examBoard"
                  placeholder="e.g. AQA"
                />
              </div>
              <div id="online-plan-field" class="hidden">
                <label for="online-plan" class="block text-sm font-semibold text-gray-900 dark:text-white"
                  >Preferred online plan</label
                >
                <select
                  class="mt-2 min-h-12 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
                  id="online-plan"
                  name="onlinePlan"
                >
                  <option value="">Not sure yet</option>
                  <option value="bronze">Bronze — £19/month</option>
                  <option value="silver">Silver — £49/month</option>
                  <option value="gold">Gold — £89/month</option>
                  <option value="full-course">Full course — £99 one-off</option>
                </select>
              </div>
            </div>
          </fieldset>

          <div class="mt-5">
            <label for="message" class="block text-sm font-semibold text-gray-900 dark:text-white">
              Message <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
            </label>
            <textarea
              class="mt-2 min-h-36 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-950 shadow-sm outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20 dark:border-gray-600 dark:bg-slate-800 dark:text-white"
              id="message"
              name="message"
              rows="6"
              required></textarea>
          </div>

          <div class="mt-5 flex items-start gap-3">
            <input
              class="mt-1 h-5 w-5 shrink-0 cursor-pointer rounded border-gray-300 text-primary focus:ring-primary"
              type="checkbox"
              id="consent"
              name="consent"
              required
            />
            <label for="consent" class="cursor-pointer text-sm leading-6 text-gray-700 dark:text-slate-300">
              I agree for MathsTutorHelp to use these details to respond to my enquiry. Information submitted here is
              processed using Hai-BL as explained in the <a
                class="font-semibold text-primary underline"
                href="/privacy/">privacy policy</a
              >.
              <span class="text-red-700 dark:text-red-300" aria-hidden="true">*</span>
            </label>
          </div>

          <div
            id="contact-error"
            class="mt-5 hidden rounded-lg border border-red-200 bg-red-50 p-4 text-sm font-semibold text-red-800 dark:border-red-800 dark:bg-red-950/40 dark:text-red-200"
            role="alert"
            aria-live="assertive"
            tabindex="-1"
          >
          </div>

          <button id="contact-submit" class="btn-primary mt-6 min-h-12 w-full justify-center" type="submit">
            Send enquiry
          </button>
          <p class="mt-4 text-center text-sm text-muted dark:text-slate-400">
            There is no payment or obligation to book when you send an enquiry.
          </p>
          <p class="mt-2 text-center text-sm text-muted dark:text-slate-400">
            If the form does not work, <a
              class="font-semibold text-primary underline"
              href={contactDetails.whatsappHref}>send a WhatsApp</a
            >
            or call <a class="font-semibold text-primary underline" href={contactDetails.phoneHref}>
              {contactDetails.phoneDisplay}</a
            >.
          </p>
        </form>
      </div>

      <div class="mt-10 rounded-xl border border-gray-200 bg-white p-5 sm:p-8 dark:border-gray-700 dark:bg-slate-900">
        <div class="max-w-2xl">
          <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Registration forms</p>
          <h3 class="mt-2 text-2xl font-bold text-gray-950 dark:text-white">Choose a specialist form</h3>
        </div>
        <div class="mt-6 grid gap-4 md:grid-cols-2">
          {
            applicationForms.map(({ title, description, action, href, isExternal = true }) => (
              <div class="flex flex-col rounded-lg border border-gray-200 p-5 dark:border-gray-700">
                <h4 class="text-lg font-bold text-gray-950 dark:text-white">{title}</h4>
                <p class="mt-2 grow text-sm leading-6 text-muted dark:text-slate-300">{description}</p>
                <a class="mt-4 inline-flex items-center gap-2 font-semibold text-primary hover:underline" href={href}>
                  {action}
                  <Icon name={isExternal ? 'tabler:external-link' : 'tabler:arrow-right'} class="h-4 w-4" />
                </a>
              </div>
            ))
          }
        </div>
        <p class="mt-5 text-sm text-muted dark:text-slate-400">
          Forms marked with the external-link icon leave MathsTutorHelp and continue to the Hai‑BL registration
          platform.
        </p>
      </div>

      <div
        class="mx-auto mt-8 max-w-4xl rounded-xl border border-gray-200 bg-white p-6 dark:border-gray-700 dark:bg-slate-900"
      >
        <h3 class="text-xl font-bold text-gray-950 dark:text-white">Manchester tuition enquiries</h3>
        <p class="mt-2 leading-7 text-muted dark:text-slate-300">
          MathsTutorHelp provides one-to-one, online and small-group tuition. In-person group classes are held at {
            courseSchedule.venue.name
          }, Manchester, M19 1FS. WhatsApp and form enquiries normally receive a reply within 24 hours; telephone calls
          that cannot be answered can be followed up by WhatsApp.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('#contact-form');
  const submitButton = document.querySelector<HTMLButtonElement>('#contact-submit');
  const errorMessage = document.querySelector<HTMLElement>('#contact-error');
  const successMessage = document.querySelector<HTMLElement>('#contact-success');
  const enquiryType = document.querySelector<HTMLSelectElement>('#enquiry-type');
  const onlinePlan = document.querySelector<HTMLSelectElement>('#online-plan');
  const onlinePlanField = document.querySelector<HTMLElement>('#online-plan-field');

  const enquiryLabels: Record<string, string> = {
    foundation: 'Foundation group class',
    higher: 'Higher group class',
    coding: 'Manchester Coding Club',
    'group-maths': 'Other group maths tuition',
    'one-to-one': 'One-to-one tuition',
    online: 'Online tuition',
    general: 'General question',
  };

  const requestedEnquiry = new URLSearchParams(window.location.search).get('enquiry');
  if (enquiryType && requestedEnquiry && requestedEnquiry in enquiryLabels) {
    enquiryType.value = requestedEnquiry;
  }
  const requestedPlan = new URLSearchParams(window.location.search).get('plan');
  if (onlinePlan && requestedPlan && [...onlinePlan.options].some((option) => option.value === requestedPlan)) {
    onlinePlan.value = requestedPlan;
  }
  const updateOnlinePlanVisibility = () => {
    onlinePlanField?.classList.toggle('hidden', enquiryType?.value !== 'online');
  };
  enquiryType?.addEventListener('change', updateOnlinePlanVisibility);
  updateOnlinePlanVisibility();

  let formStartedAt = Date.now();
  let isSubmitting = false;

  contactForm?.addEventListener('submit', async (event) => {
    event.preventDefault();

    if (isSubmitting || !contactForm.checkValidity()) {
      contactForm.reportValidity();
      return;
    }

    isSubmitting = true;
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending enquiry...';
    }
    errorMessage?.classList.add('hidden');
    if (errorMessage) errorMessage.textContent = '';

    const formData = new FormData(contactForm);
    const selectedEnquiry = String(formData.get('enquiryType') ?? '');
    const studentDetails = [
      ['Year group', String(formData.get('yearGroup') ?? '').trim()],
      ['Current grade', String(formData.get('workingGrade') ?? '').trim()],
      ['Exam board', String(formData.get('examBoard') ?? '').trim()],
      ['Preferred online plan', String(formData.get('onlinePlan') ?? '').trim()],
    ]
      .filter(([, value]) => value)
      .map(([label, value]) => `${label}: ${value}`)
      .join('\n');
    const originalMessage = String(formData.get('message') ?? '');
    const payload = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      phone: String(formData.get('phone') ?? ''),
      subject: enquiryLabels[selectedEnquiry] ?? 'General question',
      message: studentDetails ? `${originalMessage}\n\n${studentDetails}` : originalMessage,
      consent: formData.get('consent') === 'on',
      website: String(formData.get('website') ?? ''),
      formStartedAt,
    };

    try {
      const controller = new AbortController();
      const timeoutId = window.setTimeout(() => controller.abort(), 15000);
      const response = await fetch('https://hai-bl.com/api/contact', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(payload),
        signal: controller.signal,
      });
      window.clearTimeout(timeoutId);

      const result = (await response.json().catch(() => ({}))) as {
        success?: boolean;
        message?: string;
        error?: string;
      };

      if (!response.ok || !result.success) {
        throw new Error(result.error || 'Your enquiry could not be sent. Please try again.');
      }

      contactForm.reset();
      contactForm.classList.add('hidden');
      successMessage?.classList.remove('hidden');
      successMessage?.focus();
      formStartedAt = Date.now();
    } catch (error) {
      const message =
        error instanceof DOMException && error.name === 'AbortError'
          ? 'The request took too long. Please try again or use WhatsApp.'
          : error instanceof Error
            ? error.message
            : 'Your enquiry could not be sent. Please try again or use WhatsApp.';
      if (errorMessage) {
        errorMessage.textContent = message;
        errorMessage.classList.remove('hidden');
        errorMessage.focus();
      }
    } finally {
      isSubmitting = false;
      if (submitButton) {
        submitButton.disabled = false;
        submitButton.textContent = 'Send enquiry';
      }
    }
  });
</script>
