---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';
import { contactDetails, courseSchedule, ctaLabels, tuitionPrices } from '~/utils/siteDetails';
import { siteImages } from '~/data/images';
import { createEducationEventSchema } from '~/utils/educationEvent';

const metadata = {
  title: 'GCSE Higher Maths Classes Manchester',
  description:
    'MathsTutorHelp structured weekly GCSE Higher Maths sessions in Manchester for Year 10 and 11 students aiming for grades 6-9.',
  openGraph: {
    images: [{ url: '/images/gallery/classroom-circle-theorems.jpeg', width: 1200, height: 675 }],
  },
};

const interestFormUrl = 'https://hai-bl.com/onboarding/group-classes?brand=mathstutorhelp';
const contactUrl = getPermalink('/contact');
const foundationClassUrl = getPermalink('/gcse-foundation-maths-classes-manchester');
const onlineTuitionUrl = getPermalink('/online-tuition');
const phoneDisplay = contactDetails.phoneDisplay;
const eventSchema = createEducationEventSchema({
  name: 'MathsTutorHelp GCSE Higher Maths Classes Manchester',
  description: metadata.description,
  pageUrl: Astro.url,
  siteUrl: Astro.site,
  startDate: courseSchedule.gcse.higherStartDateTime,
  endDate: courseSchedule.gcse.higherEndDateTime,
  image: '/images/gallery/classroom-circle-theorems.jpeg',
  price: '20',
  bookingUrl: interestFormUrl,
  validFrom: courseSchedule.gcse.bookingValidFrom,
});
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <Hero
    tagline="MathsTutorHelp GCSE Higher Maths"
    title="MathsTutorHelp GCSE Higher Maths Classes Manchester"
    subtitle={`Structured GCSE Higher revision for grades 6–9. ${courseSchedule.gcse.day}, ${courseSchedule.gcse.higherTime} in Manchester · Maximum ${courseSchedule.gcse.maximumStudents} students · From ${tuitionPrices.smallGroup.advanceBlock}.`}
    actions={[
      {
        variant: 'primary',
        text: ctaLabels.groupClassInterest,
        href: interestFormUrl,
        icon: 'tabler:calendar-check',
      },
      { text: 'Contact MathsTutorHelp', href: contactUrl },
    ]}
    image={{
      src: siteImages.gallery.circleTheorems,
      alt: 'GCSE Maths board work from a real class',
    }}
  />

  <Features
    title="Class Details"
    subtitle="A small, focused GCSE Higher Maths group for students who need regular support, exam practice and clear feedback."
    columns={3}
    items={[
      {
        title: 'Working towards grades 6–9',
        description: 'Suitable for Higher Tier students aiming to secure or improve grades 6–9.',
        icon: 'tabler:users',
      },
      {
        title: `${courseSchedule.gcse.day}, ${courseSchedule.gcse.higherTime}`,
        description: `Weekly classes from ${courseSchedule.gcse.startDate} to ${courseSchedule.gcse.endDate}.`,
        icon: 'tabler:clock',
      },
      {
        title: courseSchedule.venue.name,
        description: 'Manchester, M19 1FS. Local in-person support in a structured classroom setting.',
        icon: 'tabler:map-pin',
      },
      {
        title: `Maximum ${courseSchedule.gcse.maximumStudents} students`,
        description: 'Small group size for personalised attention and a calmer learning environment.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Flexible pricing',
        description: `${tuitionPrices.smallGroup.display} pay-as-you-go, or ${tuitionPrices.smallGroup.advanceBlock} with advance block booking.`,
        icon: 'tabler:coin-pound',
      },
      {
        title: 'Paper-based learning',
        description: 'No screens in class, just focused GCSE-style practice and written working.',
        icon: 'tabler:file-pencil',
      },
    ]}
  />

  <Content
    isReversed
    title="What Students Get"
    items={[
      {
        title: 'Clear Higher topic teaching',
        description: 'Key GCSE Higher topics are explained clearly, with methods students can apply in exams.',
      },
      {
        title: 'Diagnostic-led planning',
        description: 'Lessons are shaped around the topics students find difficult and the skills they need for exams.',
      },
      {
        title: 'Exam question practice',
        description: 'Students practise GCSE-style questions, learn how to show working and review common mistakes.',
      },
      {
        title: 'Homework and materials',
        description:
          'Students can bring schoolwork, use tutor-provided materials or access bonus tasks and past papers.',
      },
    ]}
    image={{
      src: siteImages.higherMathsNotes,
      alt: 'GCSE Higher Maths revision notes',
    }}
  >
    <Fragment slot="content">
      <p>
        This Higher Tier group is for learners who want structured weekly support, focused revision and clear teaching
        from an experienced GCSE Maths teacher.
      </p>
    </Fragment>
  </Content>

  <Features
    title="Course Plan"
    subtitle="37 taught lessons from September 2026 to June 2027. Book by blocks for £592 instead of £740 pay-as-you-go—a saving of £148."
    columns={3}
    items={[
      {
        title: 'September–October',
        description:
          'Diagnostic assessment, number fluency, algebra foundations and a personalised list of priority topics.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'November–December',
        description:
          'Ratio and proportion, geometry, probability and multi-step Higher Tier questions, with a progress review.',
        icon: 'tabler:math',
      },
      {
        title: 'January–February',
        description:
          'Advanced Higher topics, including quadratics, functions, trigonometry and increasingly demanding problem-solving.',
        icon: 'tabler:function',
      },
      {
        title: 'March–April',
        description:
          'Full-specification review, timed topic tests and targeted teaching based on gaps found in mock papers.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'May–June',
        description:
          'Timed papers, exam technique, error analysis and focused preparation before each of the three summer papers.',
        icon: 'tabler:stopwatch',
      },
      {
        title: 'Personalised sequencing',
        description:
          'The topic order may change to match diagnostic evidence, school progress and the AQA, Edexcel or OCR specification.',
        icon: 'tabler:route',
      },
    ]}
  >
    <div class="mt-10 text-center">
      <p class="mb-5 text-muted">View every lesson date, classroom topic, block and price in the detailed programme.</p>
      <Button
        variant="primary"
        text="Download the full course plan (PDF)"
        href="/downloads/MathsTutorHelp-GCSE-Higher-Revision-Programme-2026-27.pdf"
        download
        icon="tabler:download"
      />
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-soft dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <Content
    title="Booking and Attendance"
    items={[
      {
        title: 'Reserve a place first',
        description: 'A place should be reserved before attending, as class numbers are limited.',
      },
      {
        title: 'Pay flexibly',
        description: 'Students can pay at the door once their place is reserved, or ask about block booking.',
      },
      {
        title: 'Join mid-way',
        description: 'Students can join during the year where spaces are available.',
      },
      {
        title: 'Term-time and holidays',
        description:
          'The regular timetable covers scheduled Sundays during the course. Any additional holiday sessions are confirmed separately by WhatsApp and email.',
      },
    ]}
    image={{
      src: siteImages.gallery.classroom,
      alt: 'Levenshulme classroom set up for small group maths tuition',
    }}
  >
    <Fragment slot="content">
      <p>
        Book a block or the full programme to secure your child’s place, or attend flexibly once a space has been
        reserved.
      </p>
    </Fragment>
  </Content>

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Answers for parents considering the GCSE Higher Maths class."
    columns={2}
    items={[
      {
        title: 'What if my child misses a session?',
        description: 'Let us know in advance. Where possible, your child can attend the next suitable session.',
      },
      {
        title: 'How is progress tracked?',
        description: 'Progress is tracked with mock tasks, diagnostic reviews and regular tutor feedback.',
      },
      {
        title: 'Can my child join mid-way through the term?',
        description:
          'Yes. Students can join mid-way if a place is available. The first session includes a diagnostic check.',
      },
      {
        title: 'What exam boards do you cover?',
        description: 'AQA, Edexcel and OCR are covered, with tasks tailored to your child’s specification.',
      },
      {
        title: 'Is this suitable for Foundation Tier students?',
        description: `This class is for Higher Tier. Foundation students can view the Foundation group here: <a class="underline" href="${foundationClassUrl}">GCSE Foundation class</a>.`,
      },
      {
        title: 'Who teaches the class?',
        description:
          'The class is taught by Mr Sheraz, a qualified and DBS-checked maths teacher with 15+ years of teaching experience.',
      },
      {
        title: 'Is there an online option?',
        description: `Students who prefer learning from home can view online tuition options here: <a class="underline" href="${onlineTuitionUrl}">Online Maths Tuition</a>.`,
      },
    ]}
  />

  <CallToAction
    title="Book a GCSE Higher Maths Place"
    subtitle={`Limited spaces are available. Book early to ask about the ${tuitionPrices.smallGroup.advanceBlock} advance block booking rate, or call/WhatsApp ${phoneDisplay} if you have questions.`}
    actions={[
      {
        variant: 'primary',
        text: ctaLabels.groupClassInterest,
        href: interestFormUrl,
        icon: 'tabler:calendar-check',
      },
      { text: 'Ask About One-to-One Tuition', href: contactUrl },
    ]}
  />
</Layout>
