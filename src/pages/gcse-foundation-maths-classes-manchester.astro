---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Button from '~/components/ui/Button.astro';
import { getPermalink } from '~/utils/permalinks';
import { contactDetails, courseSchedule, ctaLabels, tuitionPrices } from '~/utils/siteDetails';
import { siteImages } from '~/data/images';
import { createEducationEventSchema } from '~/utils/educationEvent';

const metadata = {
  title: 'GCSE Foundation Maths Tutoring Manchester',
  description:
    'MathsTutorHelp GCSE Foundation Maths tutoring club in Levenshulme, Manchester for Year 10 and 11 students working towards grades 4-5.',
  openGraph: {
    images: [{ url: '/images/gallery/ks3-gcse-maths-classes-manchester.jpeg', width: 1200, height: 675 }],
  },
};

const interestFormUrl = 'https://hai-bl.com/onboarding/group-classes?brand=mathstutorhelp';
const contactUrl = getPermalink('/contact');
const higherClassUrl = getPermalink('/gcse-revision-class-higher-manchester');
const onlineTuitionUrl = getPermalink('/online-tuition');
const phoneDisplay = contactDetails.phoneDisplay;
const eventSchema = createEducationEventSchema({
  name: 'MathsTutorHelp GCSE Maths Foundation Tutoring',
  description: metadata.description,
  pageUrl: Astro.url,
  siteUrl: Astro.site,
  startDate: courseSchedule.gcse.foundationStartDateTime,
  endDate: courseSchedule.gcse.foundationEndDateTime,
  image: '/images/gallery/ks3-gcse-maths-classes-manchester.jpeg',
  price: '20',
  bookingUrl: interestFormUrl,
  validFrom: courseSchedule.gcse.bookingValidFrom,
});
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />

  <Hero
    tagline="MathsTutorHelp Group Classes"
    title="MathsTutorHelp GCSE Maths Foundation Tutoring"
    subtitle={`Structured GCSE Foundation revision for grades 3–5. ${courseSchedule.gcse.day}, ${courseSchedule.gcse.foundationTime} in Manchester · Maximum ${courseSchedule.gcse.maximumStudents} students · From ${tuitionPrices.smallGroup.advanceBlock}.`}
    actions={[
      {
        variant: 'primary',
        text: ctaLabels.groupClassInterest,
        href: interestFormUrl,
        icon: 'tabler:calendar-check',
      },
      { text: 'Contact MathsTutorHelp', href: contactUrl },
    ]}
  />

  <Features
    title="Foundation Class Details"
    subtitle="A calm, structured class for students who need confidence, clear methods and regular GCSE practice."
    columns={3}
    items={[
      {
        title: 'Working towards grades 4–5',
        description:
          'Suitable for Foundation Tier students building from lower starting points and aiming to secure grades 4–5.',
        icon: 'tabler:certificate',
      },
      {
        title: `${courseSchedule.gcse.day}, ${courseSchedule.gcse.foundationTime}`,
        description: `Weekly lessons from ${courseSchedule.gcse.startDate} to ${courseSchedule.gcse.endDate}, covering the full exam preparation period.`,
        icon: 'tabler:clock',
      },
      {
        title: courseSchedule.venue.name,
        description: `In-person tutoring club at ${courseSchedule.venue.address}.`,
        icon: 'tabler:map-pin',
      },
      {
        title: `Maximum ${courseSchedule.gcse.maximumStudents} students`,
        description: 'Small groups keep lessons focused and allow students to ask questions.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Simple pricing',
        description: `${tuitionPrices.smallGroup.display} pay-as-you-go, or ${tuitionPrices.smallGroup.advanceBlock} with advance block booking.`,
        icon: 'tabler:coin-pound',
      },
      {
        title: 'No-screen lessons',
        description: 'Paper-based practice helps students focus and prepare for real exam conditions.',
        icon: 'tabler:file-pencil',
      },
    ]}
  />

  <Content
    title="What Students Work On"
    items={[
      {
        title: 'Key Foundation topics',
        description: 'Clear teaching of number, algebra, ratio, geometry and common topics needed for grades 4-5.',
      },
      {
        title: 'Exam-style practice',
        description: 'Students practise exam-style questions every lesson and learn how to show working clearly.',
      },
      {
        title: 'Diagnostic support',
        description: 'Lessons respond to weak areas so students spend time on the topics that matter most.',
      },
      {
        title: 'Independent practice',
        description: 'Students work independently with support where needed, building confidence and resilience.',
      },
      {
        title: 'Homework and materials',
        description: 'Students can bring schoolwork, use tutor-provided worksheets or access bonus practice tasks.',
      },
    ]}
    image={{
      src: siteImages.gallery.circleTheorems,
      alt: 'GCSE Maths classroom board work',
    }}
  >
    <Fragment slot="content">
      <p>
        This class is for Year 10 and Year 11 Foundation Tier students who need structured weekly support, exam practice
        and a clear route towards grades 4-5.
      </p>
    </Fragment>
  </Content>

  <Features
    title="Course Plan"
    subtitle="37 taught lessons from September 2026 to June 2027. Book by blocks for £592 instead of £740 pay-as-you-go—a saving of £148."
    columns={3}
    items={[
      {
        title: 'September–October',
        description:
          'Diagnostic assessment, number fluency, place value, fractions and the core skills needed for Foundation Maths.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'November–December',
        description:
          'Ratio, proportion, percentages, introductory algebra and geometry, followed by a progress review.',
        icon: 'tabler:math',
      },
      {
        title: 'January–February',
        description: 'Equations, graphs, area and volume, probability and multi-step questions targeting grades 4–5.',
        icon: 'tabler:function',
      },
      {
        title: 'March–April',
        description:
          'Full-specification review, timed topic tests and targeted teaching based on gaps found in mock papers.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'May–June',
        description:
          'Timed papers, calculator and non-calculator technique, error analysis and focused final preparation.',
        icon: 'tabler:stopwatch',
      },
      {
        title: 'Personalised sequencing',
        description:
          'The topic order may change to match diagnostic evidence, school progress and the AQA, Edexcel or OCR specification.',
        icon: 'tabler:route',
      },
    ]}
  >
    <div class="mt-10 text-center">
      <p class="mb-5 text-muted">View every lesson date, classroom topic, block and price in the detailed programme.</p>
      <Button
        variant="primary"
        text="Download the full course plan (PDF)"
        href="/downloads/MathsTutorHelp-GCSE-Foundation-Revision-Programme-2026-27.pdf"
        download
        icon="tabler:download"
      />
    </div>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-soft dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <Features
    title="Booking and Attendance"
    subtitle="A calm, focused Foundation class with flexible attendance once your child’s place is reserved."
    columns={2}
    items={[
      {
        title: 'Reserve a place first',
        description: 'Places are limited because the group is capped at 7 students.',
        icon: 'tabler:calendar-check',
      },
      {
        title: 'Pay flexibly',
        description: 'Students can pay on the day once their place is reserved, or ask about block booking.',
        icon: 'tabler:coin-pound',
      },
      {
        title: 'Join during the year',
        description: 'Students can join during the year where spaces remain, beginning with a diagnostic check.',
        icon: 'tabler:user-plus',
      },
      {
        title: 'Block booking',
        description: 'Book an eight-lesson block for £128, equivalent to £16 per lesson.',
        icon: 'tabler:calendar-dollar',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-soft dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <FAQs
    title="Foundation Class FAQs"
    columns={2}
    items={[
      {
        title: 'What if my child misses a session?',
        description: 'Let us know in advance. Where possible, your child can attend the next suitable session.',
      },
      {
        title: 'How is progress tracked?',
        description: 'Progress is tracked through diagnostic tasks, mock-style practice and tutor feedback.',
      },
      {
        title: 'Which exam boards are covered?',
        description: 'AQA, Edexcel and OCR can be supported, with tasks adapted to the student specification.',
      },
      {
        title: 'Can my child join mid-way through the term?',
        description:
          'Yes. Students can join mid-way if a place is available. The first session includes a diagnostic check.',
      },
      {
        title: 'Who teaches the class?',
        description:
          'The class is taught by Mr Sheraz, a qualified and DBS-checked maths teacher with 15+ years of teaching experience.',
      },
      {
        title: 'Is this suitable for Higher Tier students?',
        description: `This class is for Foundation Tier. Higher students can view the Higher group here: <a class="underline" href="${higherClassUrl}">GCSE Higher class</a>.`,
      },
      {
        title: 'Is there an online option?',
        description: `Students who prefer learning from home can view online tuition options here: <a class="underline" href="${onlineTuitionUrl}">Online Maths Tuition</a>.`,
      },
    ]}
  />

  <CallToAction
    title="Reserve a Foundation Class Place"
    subtitle={`Spaces are limited to keep the group focused and supportive. Book early to ask about the ${tuitionPrices.smallGroup.advanceBlock} advance block booking rate, or call/WhatsApp ${phoneDisplay} if you have questions.`}
    actions={[
      {
        variant: 'primary',
        text: ctaLabels.groupClassInterest,
        href: interestFormUrl,
        icon: 'tabler:calendar-check',
      },
      { text: 'Contact MathsTutorHelp', href: contactUrl },
    ]}
  />
</Layout>
