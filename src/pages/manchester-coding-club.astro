---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';
import { bookingLinks, contactDetails, courseSchedule } from '~/utils/siteDetails';
import { siteImages } from '~/data/images';

const metadata = {
  title: 'Manchester Coding Club | Python Ages 13–17',
  description:
    'Manchester Python coding club for ages 13–17. Build practical programs, strengthen problem-solving and learn Python with a qualified teacher in a calm small group.',
};

const interestFormUrl = bookingLinks.codingClassForm;
const contactUrl = '/contact/?enquiry=coding#general-enquiry';
const onlineTuitionUrl = getPermalink('/online-tuition');
const safeguardingUrl = getPermalink('/safeguarding');
const whatsappMessage = encodeURIComponent(
  "Hi Mr Sheraz, I'm interested in the Manchester Coding Club. The student is aged __ and has __ coding experience."
);
const whatsappUrl = `${contactDetails.whatsappHref}?text=${whatsappMessage}`;
const courseSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': 'https://mathstutorhelp.com/manchester-coding-club/#course',
  name: 'Manchester Python Coding Club for Ages 13–17',
  description: metadata.description,
  provider: { '@id': 'https://mathstutorhelp.com/#mathstutorhelp' },
  educationalLevel: 'Beginner',
  teaches: ['Python programming', 'Logical reasoning', 'Problem solving', 'Variables', 'Conditions', 'Loops'],
  offers: {
    '@type': 'Offer',
    price: '100',
    priceCurrency: 'GBP',
    url: interestFormUrl,
  },
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <Hero
    tagline="Manchester Coding Club"
    title="Manchester Python Coding Club for Ages 13–17"
    subtitle="A small-group Manchester coding course for ages 13–17. Build practical Python programs, strengthen problem-solving and learn from scratch with a qualified teacher."
    actions={[
      {
        variant: 'primary',
        text: 'Join the Interest List',
        href: interestFormUrl,
        icon: 'tabler:code',
      },
      { text: `WhatsApp me — ${contactDetails.phoneDisplay}`, href: whatsappUrl, icon: 'tabler:brand-whatsapp' },
    ]}
    image={{
      src: siteImages.onlineLesson,
      alt: 'Student learning with a laptop during an online lesson',
    }}
  />

  <Features
    title="Course Details"
    subtitle="A practical six-session course for beginners who want to learn coding with calm, teacher-led support."
    columns={2}
    items={[
      {
        title: `Ages ${courseSchedule.coding.ages}`,
        description: 'Suitable for complete beginners and students interested in coding, maths or technology.',
        icon: 'tabler:users',
      },
      {
        title: 'Start date and time coming soon',
        description: `${courseSchedule.coding.sessions} sessions at ${courseSchedule.venue.address}. Register interest to receive the schedule when it is announced.`,
        icon: 'tabler:clock',
      },
      {
        title: `${courseSchedule.coding.price} for ${courseSchedule.coding.sessions} sessions`,
        description: 'Approximately £17 per session, with no payment required to register interest.',
        icon: 'tabler:coin-pound',
      },
      {
        title: `Maximum ${courseSchedule.coding.maximumStudents} students`,
        description:
          'Small-group teaching from a qualified maths teacher and computer science tutor gives students focused support while they build projects.',
        icon: 'tabler:users-group',
      },
    ]}
  />

  <Content
    isReversed
    title="What Students Will Learn"
    items={[
      {
        title: 'Python from scratch',
        description: 'Students learn the basics step by step and build real programs each week.',
      },
      {
        title: 'Apps and mini tools',
        description: 'Projects include quizzes, small apps and practical tools that make coding feel real.',
      },
      {
        title: 'Maths through coding',
        description: 'The course includes formulas, substitution, sequences, averages, percentages and logic.',
      },
      {
        title: 'Next steps',
        description: 'Students can progress to advanced coding, web development or GCSE Computer Science support.',
      },
    ]}
    image={{
      src: siteImages.tutor,
      alt: 'Mr Sheraz teaching at a whiteboard',
    }}
  >
    <Fragment slot="content">
      <p>
        Give your child a powerful head start in coding in a calm, focused, small-group environment. Students learn step
        by step, build real programs and practise problem-solving through coding.
      </p>
    </Fragment>
  </Content>

  <Features
    title="Maths Skills Included"
    subtitle="The course links Python coding with useful maths thinking and logical reasoning."
    columns={3}
    items={[
      {
        title: 'Algebra in code',
        description: 'Students practise formulas, substitution and using variables in real Python programs.',
        icon: 'tabler:math-function',
      },
      {
        title: 'Sequences and patterns',
        description: 'Coding tasks help students spot patterns, repeat steps and build logical routines.',
        icon: 'tabler:repeat',
      },
      {
        title: 'Logical reasoning',
        description: 'Students practise if statements, loops and step-by-step decision making.',
        icon: 'tabler:bulb',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-soft dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <Features
    title="Requirements, Outcome and Safeguarding"
    subtitle="Clear practical arrangements for students and parents before the course begins."
    columns={2}
    items={[
      {
        title: 'Laptop required',
        description: 'Students bring a laptop and use free beginner-friendly Python software.',
        icon: 'tabler:device-laptop',
      },
      {
        title: 'No internet needed',
        description: 'Once the software is set up, coding tasks can work offline during lessons.',
        icon: 'tabler:wifi-off',
      },
      {
        title: 'Complete Python project',
        description: 'Students build a complete Python program by the end of the six sessions.',
        icon: 'tabler:code',
      },
      {
        title: 'Certificate included',
        description: 'Students receive a certificate for completing the course.',
        icon: 'tabler:award',
      },
      {
        title: 'Parent-managed communication',
        description:
          'A parent or guardian manages the initial enquiry and booking. Course communication follows the safeguarding policy.',
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <FAQs
    title="Coding Course FAQs"
    columns={2}
    items={[
      {
        title: 'Do students need coding experience?',
        description: 'No. Complete beginners are welcome, and the course starts from the basics.',
      },
      {
        title: 'Do students need internet in lessons?',
        description: 'No. The course uses offline Python software once everything is set up.',
      },
      {
        title: 'What software is used?',
        description: 'Students use Thonny, a free Python editor that is suitable for beginners.',
      },
      {
        title: 'Is an online option available?',
        description: `An online version is planned. You can also view current online support here: <a class="underline" href="${onlineTuitionUrl}">Online Tuition</a>.`,
      },
      {
        title: 'Is payment required to register interest?',
        description: 'No. Payment is not required to register interest.',
      },
      {
        title: 'How are students supported safely?',
        description: `A parent or guardian manages the initial enquiry and booking. Communication follows the <a class="underline" href="${safeguardingUrl}">MathsTutorHelp safeguarding policy</a>.`,
      },
    ]}
  />

  <section class="bg-white py-8 dark:bg-slate-900 md:py-10">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <details class="rounded-lg border border-gray-200 bg-brand-soft p-5 dark:border-gray-700 dark:bg-slate-800">
        <summary class="cursor-pointer text-lg font-bold text-primary">View the Manchester Coding Club flyer</summary>
        <div class="mx-auto mt-5 max-w-xl">
          <Image
            src={siteImages.gallery.codingFlyer}
            alt="MathsTutorHelp Manchester Coding Club flyer for students aged 13 to 17"
            width={720}
            height={874}
            widths={[400, 720]}
            sizes="(max-width: 767px) 100vw, 576px"
            layout="responsive"
            format="webp"
            loading="lazy"
            class="w-full rounded-lg border border-gray-200 bg-white"
          />
        </div>
      </details>
    </div>
  </section>

  <CallToAction
    title="Join the Manchester Coding Club Interest List"
    subtitle="Register to receive the confirmed date and time first. No payment is required to join the interest list."
    actions={[
      {
        variant: 'primary',
        text: 'Join the Interest List',
        href: interestFormUrl,
        icon: 'tabler:send',
      },
      { text: `WhatsApp me — ${contactDetails.phoneDisplay}`, href: whatsappUrl, icon: 'tabler:brand-whatsapp' },
      { text: 'Ask a Question', href: contactUrl, icon: 'tabler:message-circle' },
    ]}
  />
</Layout>
