---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import { getPermalink } from '~/utils/permalinks';
import { bookingLinks, contactDetails, courseSchedule, ctaLabels } from '~/utils/siteDetails';
import { siteImages } from '~/data/images';

const metadata = {
  title: 'About Mr Sheraz | Qualified Maths Teacher Manchester',
  description:
    'Learn about MathsTutorHelp and Mr Sheraz, a qualified and DBS-checked maths teacher providing GCSE, IGCSE, Functional Skills, A-Level maths tuition and beginner coding support in Manchester and online.',
};

const consultationBookingUrl = bookingLinks.freeConsultation;
const contactUrl = getPermalink('/contact');
const safeguardingUrl = getPermalink('/safeguarding');
const tutorImageUrl = siteImages.tutor;
const whatsappMessage = encodeURIComponent(
  "Hi Mr Sheraz, I'm looking for maths tuition. The student is in Year __ and needs help with __."
);
const whatsappUrl = `${contactDetails.whatsappHref}?text=${whatsappMessage}`;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://mathstutorhelp.com/about/#mr-sheraz',
  name: 'Mr Sheraz',
  url: 'https://mathstutorhelp.com/about/',
  image: 'https://mathstutorhelp.com/images/maths-tutor-sheraz-cheema.jpeg',
  jobTitle: 'Qualified Maths Teacher and Computer Science Tutor',
  worksFor: { '@id': 'https://mathstutorhelp.com/#mathstutorhelp' },
  workLocation: {
    '@type': 'Place',
    name: 'Manchester and online',
  },
  knowsAbout: [
    'GCSE Maths',
    'IGCSE Maths',
    'KS3 Maths',
    'Functional Skills Maths',
    'A-Level Maths',
    'Online Maths Tuition',
    'Python coding',
  ],
  sameAs: [
    'https://www.facebook.com/mathstutorhelp',
    'https://www.linkedin.com/in/mathstutorhelp/',
    'https://www.instagram.com/mathstutorhelp/',
  ],
};
---

<Layout metadata={metadata}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

  <Hero
    tagline="About MathsTutorHelp"
    title="About Mr Sheraz and MathsTutorHelp"
    subtitle="Qualified, DBS-checked maths tuition for students in Manchester and online, with lessons built around clear explanations, confidence and steady progress."
    actions={[
      {
        variant: 'primary',
        text: 'Discuss Tuition Options',
        href: contactUrl,
        icon: 'tabler:message-circle',
      },
      { text: ctaLabels.freeConsultation, href: consultationBookingUrl, icon: 'tabler:calendar-check' },
    ]}
  />

  <Content
    title="Meet Mr Sheraz at MathsTutorHelp"
    items={[
      {
        title: 'Qualified teacher',
        description:
          'A fully qualified maths teacher with classroom, private tuition and computer science teaching experience.',
      },
      {
        title: 'DBS checked',
        description: 'Professional, responsible support for students and families.',
      },
      {
        title: "15+ years' experience",
        description: 'Experience supporting learners across schools, colleges, international settings and tuition.',
      },
    ]}
    image={{
      src: tutorImageUrl,
      alt: 'Mr Sheraz teaching maths',
    }}
  >
    <Fragment slot="content">
      <p>
        My name is Mr Sheraz. I founded MathsTutorHelp to give students calm, structured support with clear
        explanations, purposeful practice and individual attention.
      </p>
      <p>
        I bring more than 15 years of experience across schools, colleges, international settings and private tuition.
        My background includes classroom maths, exam preparation and computer science teaching.
      </p>
      <p>
        MathsTutorHelp is designed for students who need more than another set of questions. Lessons give them time to
        understand why a method works, practise it with support and build the confidence to use it independently.
      </p>
      <p>
        My aim is to make lessons calm and purposeful. I identify the student’s current gaps, explain ideas in
        manageable steps and use focused practice to help them make steady progress towards their goals.
      </p>
    </Fragment>
  </Content>

  <Features
    title="My Teaching Approach"
    subtitle="Lessons are clear, patient and exam-aware without feeling rushed or overwhelming."
    columns={2}
    items={[
      {
        title: 'Clear explanations',
        description: 'Topics are broken into simple steps so students understand the method, not just the answer.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Guided practice',
        description: 'Students practise with examples, feedback and questions matched to their current level.',
        icon: 'tabler:pencil-check',
      },
      {
        title: 'Exam technique',
        description: 'GCSE, IGCSE and A-Level students practise exam-style questions and written working.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Personalised support',
        description: 'Lessons are adapted to the student’s level, goals and areas of difficulty.',
        icon: 'tabler:user-check',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-soft dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <Features
    title="Who I Support and How"
    subtitle="Flexible support for different stages, goals and preferred ways of learning."
    columns={3}
    items={[
      {
        title: 'Year 6 and KS3',
        description: 'Number confidence, problem solving, secondary transition and strong foundations before GCSE.',
        icon: 'tabler:school',
      },
      {
        title: 'GCSE and IGCSE Maths',
        description: 'Foundation and Higher topic support, worked examples, written methods and exam practice.',
        icon: 'tabler:certificate',
      },
      {
        title: 'Functional Skills and A-Level',
        description: 'Practical assessment preparation plus Pure Maths, Statistics, Mechanics and problem solving.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'One-to-one tuition',
        description: 'Personalised support available online or in person from Levenshulme, Manchester.',
        icon: 'tabler:user-check',
      },
      {
        title: 'Small GCSE groups',
        description: `Foundation and Higher classes at ${courseSchedule.venue.name}, capped at ${courseSchedule.gcse.maximumStudents} students.`,
        icon: 'tabler:users-group',
      },
      {
        title: 'Online learning',
        description: 'Live online tuition and structured course memberships for students learning from home.',
        icon: 'tabler:device-laptop',
      },
    ]}
  />

  <Testimonials
    tagline="Parent and Student Feedback"
    title="What Families Say"
    subtitle="Feedback shared with permission. Names are withheld for student and family privacy."
    classes={{ container: 'py-8 md:py-10 lg:py-12' }}
    testimonials={[
      {
        title: 'More confidence with exam questions',
        testimonial:
          'Mr Sheraz explains topics clearly and gives my child the confidence to try exam questions independently.',
        name: 'GCSE parent',
        job: 'Manchester',
      },
      {
        title: 'Confidence improved',
        testimonial:
          'The lessons are structured and calm. We can see better confidence and stronger exam technique each week.',
        name: 'Year 11 parent',
        job: 'Levenshulme',
      },
      {
        title: 'Helpful exam practice',
        testimonial:
          'I understand the methods much better now, especially when working through past-paper questions step by step.',
        name: 'A-Level student',
        job: 'Online tuition',
      },
    ]}
  />

  <Features
    title="Why Families Choose MathsTutorHelp"
    subtitle="Professional support with clear communication and safeguarding."
    columns={3}
    items={[
      {
        title: 'Small, focused groups',
        description: `In-person groups are capped at ${courseSchedule.gcse.maximumStudents} students.`,
        icon: 'tabler:users-group',
      },
      {
        title: 'Direct parent communication',
        description: 'Parents can ask questions and request clear feedback through WhatsApp or email.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Safeguarding-conscious support',
        description: `Professional, DBS-checked support with a clear <a class="underline" href="${safeguardingUrl}">safeguarding policy</a>.`,
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <CallToAction
    title="Ready to Discuss Maths Tuition?"
    subtitle="Tell me the student’s age or year group, current level, goals and preferred learning format. I will help you choose the right next step."
    actions={[
      {
        variant: 'primary',
        text: 'Discuss Tuition Options',
        href: contactUrl,
        icon: 'tabler:message-circle',
      },
      {
        text: `WhatsApp me — ${contactDetails.phoneDisplay}`,
        href: whatsappUrl,
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  />
</Layout>
