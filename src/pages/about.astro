---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';
import { bookingLinks, contactDetails, courseSchedule, ctaLabels } from '~/utils/siteDetails';
import { siteImages } from '~/data/images';

const metadata = {
  title: 'About Mr Sheraz',
  description:
    'Learn about MathsTutorHelp and Mr Sheraz, a qualified and DBS-checked maths teacher providing GCSE, IGCSE, Functional Skills, A-Level maths tuition and beginner coding support in Manchester and online.',
};

const consultationBookingUrl = bookingLinks.freeConsultation;
const tuitionUrl = getPermalink('/maths-tuition');
const safeguardingUrl = getPermalink('/safeguarding');
const tutorImageUrl = siteImages.tutor;
---

<Layout metadata={metadata}>
  <Hero
    tagline="About MathsTutorHelp"
    title="About Mr Sheraz and MathsTutorHelp"
    subtitle="Qualified, DBS-checked maths and coding support for students in Manchester and online, with lessons built around clear explanations, confidence and steady progress."
    actions={[
      {
        variant: 'primary',
        text: ctaLabels.freeConsultation,
        href: consultationBookingUrl,
        icon: 'tabler:calendar-check',
      },
      { text: 'View Tuition Options', href: tuitionUrl },
    ]}
  />

  <Content
    title="Meet Mr Sheraz at MathsTutorHelp"
    items={[
      {
        title: 'Qualified teacher',
        description:
          'A fully qualified maths teacher with classroom, private tuition and computer science teaching experience.',
      },
      {
        title: 'DBS checked',
        description: 'Professional, responsible support for students and families.',
      },
      {
        title: "15+ years' experience",
        description: 'Experience supporting learners across schools, colleges, international settings and tuition.',
      },
    ]}
    image={{
      src: tutorImageUrl,
      alt: 'Mr Sheraz teaching maths',
    }}
  >
    <Fragment slot="content">
      <p>
        My name is Mr Sheraz. I founded MathsTutorHelp to give students calm, structured support with clear
        explanations, purposeful practice and individual attention.
      </p>
      <p>
        I bring more than 15 years of experience across schools, colleges, international settings and private tuition.
        My background includes classroom maths, exam preparation and computer science teaching.
      </p>
    </Fragment>
  </Content>

  <Features
    title="My Teaching Approach"
    subtitle="Lessons are clear, patient and exam-aware without feeling rushed or overwhelming."
    columns={3}
    items={[
      {
        title: 'Clear explanations',
        description: 'Topics are broken into simple steps so students understand the method, not just the answer.',
        icon: 'tabler:chalkboard',
      },
      {
        title: 'Guided practice',
        description: 'Students practise with examples, feedback and questions matched to their current level.',
        icon: 'tabler:pencil-check',
      },
      {
        title: 'Exam technique',
        description: 'GCSE, IGCSE and A-Level students practise exam-style questions and written working.',
        icon: 'tabler:file-check',
      },
      {
        title: 'Personalised support',
        description: 'Lessons are adapted to the student’s level, goals and areas of difficulty.',
        icon: 'tabler:user-check',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-brand-soft dark:bg-transparent"></div>
    </Fragment>
  </Features>

  <Features
    title="Who I Support"
    subtitle="Support is available for students who need confidence, exam preparation or structured help with school topics."
    columns={3}
    items={[
      {
        title: 'Year 6 and transition',
        description: 'Number confidence, problem solving and preparation for secondary school.',
        icon: 'tabler:school',
      },
      {
        title: 'KS3 Maths',
        description: 'Years 7-9 foundations before GCSE.',
        icon: 'tabler:books',
      },
      {
        title: 'GCSE Maths',
        description: 'Foundation and Higher support with exam practice.',
        icon: 'tabler:certificate',
      },
      {
        title: 'IGCSE Maths',
        description: 'Topic revision, worked examples and exam technique.',
        icon: 'tabler:calculator',
      },
      {
        title: 'Functional Skills',
        description: 'Practical maths for everyday use and assessments.',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'A-Level Maths',
        description: 'Pure maths, statistics, mechanics and problem solving.',
        icon: 'tabler:function',
      },
      {
        title: 'Coding',
        description: 'Beginner Python and problem-solving support.',
        icon: 'tabler:code',
      },
    ]}
  />

  <Content
    isReversed
    title="Local and Online Maths Tuition"
    items={[
      {
        title: 'One-to-one tuition',
        description: 'Available online or in person from Levenshulme, Manchester.',
      },
      {
        title: 'In-person GCSE groups',
        description: `Foundation and Higher classes are held at ${courseSchedule.venue.name} with a maximum of ${courseSchedule.gcse.maximumStudents} students.`,
      },
      {
        title: 'Online courses and coding',
        description: 'Structured online memberships plus beginner Python support for ages 13–17.',
      },
    ]}
    image={{
      src: siteImages.gallery.classroom,
      alt: 'Levenshulme classroom set up for small group maths tuition',
    }}
  >
    <Fragment slot="content">
      <p>Choose from one-to-one tuition, small GCSE groups or structured online support.</p>
    </Fragment>
  </Content>

  <Features
    title="Why Families Choose MathsTutorHelp"
    subtitle="Professional support with clear communication and safeguarding."
    columns={3}
    items={[
      {
        title: 'Small, focused groups',
        description: `In-person groups are capped at ${courseSchedule.gcse.maximumStudents} students.`,
        icon: 'tabler:users-group',
      },
      {
        title: 'Direct parent communication',
        description: 'Parents can ask questions and request clear feedback through WhatsApp or email.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Safeguarding-conscious support',
        description: `Professional, DBS-checked support with a clear <a class="underline" href="${safeguardingUrl}">safeguarding policy</a>.`,
        icon: 'tabler:shield-check',
      },
    ]}
  />

  <CallToAction
    title="Ready to Discuss Maths or Coding Support?"
    subtitle="Tell me the student’s age or year group, current level, goals and preferred learning format. I will help you choose the right next step."
    actions={[
      {
        variant: 'primary',
        text: ctaLabels.freeConsultation,
        href: consultationBookingUrl,
        icon: 'tabler:calendar-check',
      },
      {
        text: 'WhatsApp MathsTutorHelp',
        href: contactDetails.whatsappHref,
        icon: 'tabler:brand-whatsapp',
      },
    ]}
  />
</Layout>
