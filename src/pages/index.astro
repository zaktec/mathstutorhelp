---
import Layout from '~/layouts/PageLayout.astro';

import HomeHero from '~/components/widgets/HomeHero.astro';
import TrustStrip from '~/components/widgets/TrustStrip.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '~/utils/permalinks';
import { bookingLinks, courseSchedule, ctaLabels, tuitionPrices } from '~/utils/siteDetails';

const metadata = {
  title: 'MathsTutorHelp | Maths Tutor Manchester',
  description:
    'Qualified maths tutor in Manchester offering GCSE, IGCSE, KS3 and A-Level tuition. Online lessons and small-group classes in Levenshulme.',
  ignoreTitleTemplate: true,
};

const consultationBookingUrl = bookingLinks.freeConsultation;
const groupClassInterestUrl = bookingLinks.groupClassInterest;
const gcseClassesUrl = getPermalink('/gcse-classes');
const mathsTuitionUrl = getPermalink('/maths-tuition');
const onlineTuitionUrl = getPermalink('/online-tuition');
const codingCourseUrl = getPermalink('/manchestersummercodingclub');
const compactSection = { container: 'py-8 md:py-10 lg:py-12' };
---

<Layout metadata={metadata}>
  <HomeHero interestUrl={groupClassInterestUrl} />

  <TrustStrip
    id="why-parents-choose"
    tagline="Why Parents Choose MathsTutorHelp"
    title="Trusted, Structured Support"
    items={[
      { title: 'Qualified Teacher', icon: 'tabler:certificate' },
      { title: 'DBS Checked', icon: 'tabler:shield-check' },
      { title: "15+ Years' Experience", icon: 'tabler:award' },
      { title: 'Maximum 7 Per Group', icon: 'tabler:users-group' },
    ]}
  />

  <section id="now-enrolling" class="bg-white py-8 dark:bg-slate-900 md:py-10 lg:py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div
        class="grid gap-6 rounded-lg border border-primary/20 bg-brand-soft p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800 md:grid-cols-[1fr_auto] md:items-center md:p-8"
      >
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Upcoming Classes</p>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-950 dark:text-white">
            GCSE Classes Starting September 2026
          </h2>
          <p class="mt-3 max-w-3xl text-base leading-7 text-muted dark:text-slate-300">
            Small GCSE Foundation and Higher classes begin on Sunday {courseSchedule.gcse.startDate} at{' '}
            {courseSchedule.venue.name}.
          </p>
          <div class="mt-4 flex flex-wrap gap-2 text-sm font-bold text-gray-800 dark:text-slate-200">
            <span class="rounded-full bg-white px-3 py-1 dark:bg-slate-900"
              >Foundation: {courseSchedule.gcse.foundationTime}</span
            >
            <span class="rounded-full bg-white px-3 py-1 dark:bg-slate-900"
              >Higher: {courseSchedule.gcse.higherTime}</span
            >
            <span class="rounded-full bg-white px-3 py-1 dark:bg-slate-900"
              >Maximum {courseSchedule.gcse.maximumStudents} students per class</span
            >
          </div>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row md:flex-col">
          <a class="btn-primary justify-center" href={groupClassInterestUrl}>Register Interest</a>
          <a class="btn-secondary justify-center" href={gcseClassesUrl}>View Group Classes</a>
        </div>
      </div>
    </div>
  </section>

  <Features2
    id="choose-your-support"
    tagline="Tuition Options and Prices"
    title="Choose Your Support"
    subtitle="Not sure which option is right? Tell me the student’s year group, current level and goals, and I’ll help you choose."
    columns={2}
    classes={compactSection}
    items={[
      {
        title: `GCSE Group Classes — ${tuitionPrices.smallGroup.display}`,
        description:
          'Small Foundation and Higher classes in Levenshulme, with clear teaching, regular exam practice and a maximum of seven students.',
        icon: 'tabler:users-group',
        callToAction: { text: 'View Group Classes', href: gcseClassesUrl },
      },
      {
        title: `In-Person One-to-One — ${tuitionPrices.oneToOne.display}`,
        description:
          'Personalised GCSE, IGCSE, KS3, Functional Skills or A-Level support focused on the student’s gaps and goals.',
        icon: 'tabler:user-check',
        callToAction: { text: 'View One-to-One Tuition', href: mathsTuitionUrl },
      },
      {
        title: `Live Online Tuition — ${tuitionPrices.online.display}`,
        description: 'Focused live lessons with Mr Sheraz for students who need personalised support from home.',
        icon: 'tabler:device-laptop',
        callToAction: { text: 'View Live Tuition', href: `${mathsTuitionUrl}#tuition-options` },
      },
      {
        title: 'Online Course Memberships',
        description:
          'Structured weekly course content with tutor monitoring. Silver and Gold plans also include live online lessons.',
        icon: 'tabler:books',
        callToAction: { text: 'Compare Memberships', href: onlineTuitionUrl },
      },
    ]}
  />

  <Testimonials
    tagline="Parent Feedback"
    title="What Families Say"
    subtitle="Short reflections from parents and students who value calm, structured maths support. Names are withheld for student and family privacy."
    classes={{ container: 'py-8 md:py-10 lg:py-12' }}
    testimonials={[
      {
        title: 'More confidence with exam questions',
        testimonial:
          'Mr Sheraz explains topics clearly and gives my child the confidence to try exam questions independently.',
        name: 'GCSE parent',
        job: 'Manchester',
      },
      {
        title: 'Confidence improved',
        testimonial:
          'The lessons are structured and calm. We can see better confidence and stronger exam technique each week.',
        name: 'Year 11 parent',
        job: 'Levenshulme',
      },
      {
        title: 'Helpful exam practice',
        testimonial:
          'I understand the methods much better now, especially when working through past-paper questions step by step.',
        name: 'A-Level student',
        job: 'Online tuition',
      },
    ]}
  />

  <section class="bg-brand-soft py-8 dark:bg-slate-900 md:py-10 lg:py-12">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div
        class="grid gap-5 rounded-lg border border-gray-200 bg-white p-6 shadow-sm md:grid-cols-[1fr_auto] md:items-center md:p-8 dark:border-gray-700 dark:bg-slate-800"
      >
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-secondary dark:text-teal-200">Also Available</p>
          <h2 class="mt-2 text-2xl font-bold text-gray-950 dark:text-white">Coding and Problem-Solving</h2>
          <p class="mt-3 max-w-3xl leading-7 text-muted dark:text-slate-300">
            Beginner coding support for students who want to build logic, confidence and practical problem-solving
            skills.
          </p>
        </div>
        <a class="btn-secondary justify-center" href={codingCourseUrl}>View Coding Course</a>
      </div>
    </div>
  </section>

  <CallToAction
    classes={compactSection}
    actions={[
      {
        variant: 'primary',
        text: 'Register Interest',
        href: groupClassInterestUrl,
        icon: 'tabler:calendar-check',
      },
      { text: ctaLabels.freeConsultation, href: consultationBookingUrl },
    ]}
  >
    <Fragment slot="title">Ready to Find the Right Maths Support?</Fragment>

    <Fragment slot="subtitle">
      Tell me the student’s level and target grade. I’ll help you choose the best option.
    </Fragment>
  </CallToAction>
</Layout>
